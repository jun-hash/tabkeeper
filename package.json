{
  "name": "tabkeeper",
  "version": "0.1.0",
  "description": "Arc-style auto-archiving for idle tabs and workspaces in agent terminals like Orca and cmux.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tabkeeper": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run format:check && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "orca",
    "cmux",
    "terminal",
    "tabs",
    "archive",
    "agents",
    "claude-code"
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jun-hash/tabkeeper.git"
  },
  "homepage": "https://github.com/jun-hash/tabkeeper#readme",
  "bugs": {
    "url": "https://github.com/jun-hash/tabkeeper/issues"
  }
}
